# VisualAI - Environment Configuration Template

# --- Legacy/local LLM selection; semantic tasks use the Cloudflare router below ---
LLM_PROVIDER=ollama                  # Options: ollama | mock
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b             # Local reasoning LLM (100% offline, 3B parameters)
REASONING_MODEL=llama3.2:3b
GENERATION_MODEL=llama3.2:3b

# --- Local Embedding Model ---
EMBEDDING_PROVIDER=ollama            # mock is explicit automated-test configuration only
EMBEDDING_FALLBACK_MODEL=embeddinggemma # Only used when configured model returns model-not-found; blank disables fallback
# OLLAMA_EMBED_MODEL is a legacy alias; if supplied, it takes precedence over EMBEDDING_MODEL.
EMBEDDING_MODEL=embeddinggemma       # Local 768-dim embedding model via Ollama /api/embed

# --- Vector Database (Qdrant) ---
QDRANT_URL=http://localhost:6333     # Falls back to local embedded disk store if offline
QDRANT_COLLECTION=visualai_layer_a_v1
COLLECTION_NAME=visualai_layer_a_v1
QDRANT_API_KEY=

# --- Storage Directories ---
UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
VIDEO_OUTPUT_DIR=storage/videos
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt,mp4,mov,mkv

# --- Video Processing & Alignment ---
WHISPER_MODEL=base                   # Faster-Whisper model size (base, small, medium)
WHISPER_MODEL_SIZE=base
FRAME_INTERVAL_SECONDS=12
VIDEO_FRAME_SIMILARITY_THRESHOLD=0.04

# --- Step 2: Assessment & Diagnostic Rules ---
MAX_QUESTIONS=10
ASSESSMENT_PASS_THRESHOLD=70.0
PASS_THRESHOLD=70.0
MASTERY_THRESHOLD=2                  # Consecutive passes required for MASTERED state
KILL_SWITCH_LIMIT=3                  # Failures before triggering REQUIRES_HUMAN_FALLBACK
ASSESSMENT_TTL_HOURS=24
MAX_QUESTION_RETRIES=2

# --- Step 3: Video Engine & Manim Rendering ---
TTS_PROVIDER=edge_tts                # Options: edge_tts | mock
VIDEO_TIMEOUT=180
MANIM_QUALITY=low                    # Options: low, medium, high
FFMPEG_PRESET=fast

# --- Security Settings (SEC-002, SEC-003, SEC-006, SEC-011) ---
INSTRUCTOR_API_KEY=
VISUALAI_DEBUG=false
MAX_UPLOAD_SIZE_MB=200
VISUALAI_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Background Job Admission Control & Concurrency (BUG-002) ---
MAX_BACKGROUND_JOBS=2               # Max concurrent in-process background pipeline executions
MAX_PENDING_JOBS=20                 # Max queued/active jobs before rejecting with HTTP 429
JOB_RETENTION_MAX=100               # Max completed/failed job records retained in memory

# --- Multimodal Vision Extraction (Ollama Google Gemma 3 4B - Instant Local Vision) ---
# Cloud tiers require the approved visual Worker deployment. Explicit offline mode: ollama.
# VISION_MODEL and OLLAMA_VISION_MODEL select local/offline or last-resort inference only.
VISION_PROVIDER=cloudflare
OLLAMA_VISION_MODEL=gemma3:4b
VISION_MODEL=gemma3:4b
VISION_TIMEOUT_SECONDS=45
VISION_STAGE_TIMEOUT_SECONDS=90
EXTRACTION_STAGE_TIMEOUT_SECONDS=100
VISION_MAX_RETRIES=1

# --- Database & Persistence Architecture (Supabase / Local File) ---
DATABASE_PROVIDER=file
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Existing ANON_KEY/SERVICE_ROLE_KEY names remain supported; modern names take precedence.
# Public credentials are for Auth/user-scoped operations. Secret credentials stay backend-only.
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_TIMEOUT_SECONDS=10

# Match the application login URL and add it to Supabase Auth URL Configuration.
SUPABASE_AUTH_REDIRECT_URL=http://127.0.0.1:8000/login

# --- Cloudflare-primary semantic reasoning (understanding, QA, notes, assessment) ---
CLOUDFLARE_WORKER_URL=
CLOUDFLARE_WORKER_SECRET=
CLOUDFLARE_CONNECT_TIMEOUT=5
CLOUDFLARE_READ_TIMEOUT=45
CLOUDFLARE_OVERALL_TIMEOUT=60
CLOUDFLARE_MAX_RETRIES=1
CLOUDFLARE_CIRCUIT_THRESHOLD=3
CLOUDFLARE_CIRCUIT_COOLDOWN=60

# Optional local development verification; disabled by default.
VISUAL_INDEPENDENT_VERIFIER=cloudflare

# Cloud visual extraction uses the qualified cloud chain; local vision is explicit offline only.
