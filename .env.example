# VisualAI - Environment Configuration Template

# --- LLM Provider Selection (Local-First) ---
LLM_PROVIDER=ollama                  # Options: ollama | mock
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b             # Local reasoning LLM (100% offline)
REASONING_MODEL=llama3.2:3b
GENERATION_MODEL=llama3.2:3b

# --- Local Embedding Model ---
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Vector Database (Qdrant) ---
QDRANT_URL=http://localhost:6333     # Falls back to local embedded disk store if offline
QDRANT_COLLECTION=visualai_layer_a_v1
COLLECTION_NAME=visualai_layer_a_v1
QDRANT_API_KEY=

# --- Storage Directories ---
UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
VIDEO_OUTPUT_DIR=storage/videos
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt,mp4,mov,mkv

# --- Video Processing & Alignment ---
WHISPER_MODEL=base                   # Faster-Whisper model size (base, small, medium)
WHISPER_MODEL_SIZE=base
FRAME_INTERVAL_SECONDS=12
VIDEO_FRAME_SIMILARITY_THRESHOLD=0.04

# --- Step 2: Assessment & Diagnostic Rules ---
MAX_QUESTIONS=10
ASSESSMENT_PASS_THRESHOLD=70.0
PASS_THRESHOLD=70.0
MASTERY_THRESHOLD=2                  # Consecutive passes required for MASTERED state
KILL_SWITCH_LIMIT=3                  # Failures before triggering REQUIRES_HUMAN_FALLBACK
ASSESSMENT_TTL_HOURS=24
MAX_QUESTION_RETRIES=2

# --- Step 3: Video Engine & Manim Rendering ---
TTS_PROVIDER=edge_tts                # Options: edge_tts | mock
VIDEO_TIMEOUT=180
MANIM_QUALITY=low                    # Options: low, medium, high
FFMPEG_PRESET=fast

# --- Security Settings (SEC-002, SEC-003, SEC-006, SEC-011) ---
INSTRUCTOR_API_KEY=your_instructor_api_key_here
VISUALAI_DEBUG=false
MAX_UPLOAD_SIZE_MB=200
VISUALAI_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000