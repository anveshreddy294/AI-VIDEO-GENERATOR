# LLM Provider Configuration (omniroute or gemini)
LLM_PROVIDER=omniroute
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=static-best-reasoning

GEMINI_API_KEY=your_gemini_api_key_here
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=visualai_layer_a
UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt,mp4,mov,mkv
EMBEDDING_MODEL=models/gemini-embedding-2
GENERATION_MODEL=gemini-3.5-flash
WHISPER_MODEL_SIZE=large-v3
FRAME_INTERVAL_SECONDS=12
VIDEO_FRAME_SIMILARITY_THRESHOLD=0.04

# Step 2: Assessment
MAX_QUESTIONS=10
ASSESSMENT_TTL_HOURS=24
MAX_QUESTION_RETRIES=2
MASTERY_THRESHOLD=2
KILL_SWITCH_LIMIT=3

# Security Settings (SEC-002, SEC-003, SEC-006, SEC-011)
# SEC-003: Set a strong random key to protect the Instructor Portal API
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INSTRUCTOR_API_KEY=your_instructor_api_key_here

# SEC-002: Set to 'true' ONLY in local dev to enable /debug/qdrant diagnostic endpoint
# NEVER set to true in production
VISUALAI_DEBUG=false

# SEC-006: Maximum upload file size in megabytes (default: 200 MB)
MAX_UPLOAD_SIZE_MB=200

# SEC-011: Comma-separated allowed CORS origins for browser requests
# For production, change to your actual deployment domain
VISUALAI_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000