# Copy this file to .env before running the Docker setup.
# Required for the main pipeline: at least one of the following should be set.
GEMINI_API_KEY=
NVIDIA_API_KEY=

# Optional local model server for PageIndex / Ollama-backed inference.
# If you want Ollama in a separate container, point this at the Ollama service.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b

# Optional API / model overrides
GEMINI_MODEL=gemini-3.5-flash
NVIDIA_PLANNER_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_REPAIR_MODEL=deepseek-ai/deepseek-r1

# Piper / WhisperX tuning
PIPER_MODEL=en_US-lessac-medium
USE_WHISPERX=false
WHISPERX_MODEL=base
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE_TYPE=int8

# Pipeline settings
LOG_LEVEL=INFO
MANIM_REPAIR_TIMEOUT=30
MANIM_REPAIR_MAX_CALLS=1
MANIM_QUALITY=-qm
MANIM_MAX_RETRIES=3
